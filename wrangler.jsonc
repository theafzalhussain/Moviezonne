{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moviezonne",
  "main": "worker.js",
  "compatibility_date": "2026-08-17",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "TMDB_CACHE",
      "id": "7afa38a8eae1409285fbbd368e6d0063"
    },
    {
      "binding": "PUSH_SUBS",
      "id": "YAHAN_NAYA_KV_ID_DALO"
    }
  ]
}
