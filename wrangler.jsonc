{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moviezonne",
  "main": "worker.js",
  "compatibility_date": "2026-08-17",

  /*  head_sampling_rate, not "sampling" — that is the key the runtime reads, and
   *  an unknown field here is silently ignored, so a typo looks like it worked.
   *  1 = keep every invocation, which is also the default; stated explicitly so
   *  nobody has to guess whether logs are being dropped while debugging. */
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  /*  ── TUNABLES, READABLE WITHOUT A DEPLOY ──
   *  worker.js reads each of these through envInt(), which clamps the value and
   *  falls back to the compiled-in default if it is missing or malformed. So they
   *  are safe to change from the dashboard mid-incident, and deleting one restores
   *  the default rather than breaking the Worker.
   *
   *  TMDB_TIMEOUT_MS   per-attempt ceiling on the upstream TMDB call, two attempts
   *                    max. Kept under the browser's own 15s per-attempt timeout,
   *                    or the edge retry would land after the client gave up.
   *                    Before any timeout existed, a stalled TMDB connection held
   *                    the request open forever — that is what produced 504s.
   *
   *                    RAISED 3000 -> 5000 (Sep 2026), measured rather than
   *                    guessed. A forced-cold /api/tmdb/discover/movie through the
   *                    Worker from the DEL colo answered in 892-1628ms end to end,
   *                    and that figure still includes the client's own round trip
   *                    — so the upstream leg is roughly 0.7-1.4s and 3000 left
   *                    barely 2x headroom on the slow end. It matters only on a
   *                    COLD path: a warm path is answered from KV or the colo
   *                    cache and never reaches the timeout at all, while a cold
   *                    path that times out returns a 503 that is deliberately not
   *                    cached, so the visitor gets an empty rail. 5000 gives >3x
   *                    headroom there. It is not 6000 or 7000: two attempts must
   *                    stay clear of the client's 15s per-attempt budget with room
   *                    left for the KV read and the JSON assembly, and 2x6000
   *                    leaves only 3s for all of that — the invariant the comment
   *                    on TMDB_UPSTREAM_TIMEOUT_MS in worker.js protects. 2x5000
   *                    leaves 5s.
   *  PUSH_TIMEOUT_MS   same idea for the push services.
   *
   *  There is deliberately NO single TMDB_CACHE_TTL. One number cannot be right
   *  for both halves: /movie/{id} does not change (7 days), while /trending,
   *  /movie/now_playing and the /discover queries the home feed is built from ARE
   *  the "what is out now" answer (3 hours). A flat 3600 would re-fetch the
   *  unchanging majority all day AND still be the shortest link in the chain.
   *  Both are separately overridable below.
   *
   *  ── DO NOT LOWER TMDB_CACHE_TTL TO "FIX" STALE DATA OR COLD READS ──
   *  It has been proposed twice, on the reasoning that 604800 means a visitor can
   *  be served a 7-day-old body. It does not, and the confusion is worth writing
   *  down because the change would make both symptoms worse.
   *
   *  These two numbers are FRESHNESS WINDOWS, not retention. Retention is a
   *  separate value putTmdb() derives from them (expirationTtl = softTtl * 8,
   *  capped at 30 days) and it only decides when KV deletes the bytes. Freshness
   *  lives in the entry's METADATA: putTmdb stores `{ t: Date.now() }`, and
   *  fetchTmdbJson compares `Date.now() - storedAt < softTtl * 1000`. Past that it
   *  serves the stale body AND fires refreshTmdb() through ctx.waitUntil — so no
   *  entry is ever handed over without a refresh being started behind it. Nothing
   *  in that decision reads expirationTtl.
   *
   *  Concretely:
   *    volatile  freshness 3h,  retention 1d   <- the entire home feed
   *    static    freshness 7d,  retention 30d  <- /movie/{id}, /tv/{id} only
   *
   *  So the home feed is already on a 3-hour window; 604800 never touches it. It
   *  applies to a title's own record — cast, runtime, overview, poster path — and
   *  those do not change. Lowering it to 86400 would re-fetch every one of those
   *  records SEVEN TIMES more often: more upstream calls, more KV writes, and more
   *  cold reads. It would worsen the exact number it is meant to improve.
   */
  "vars": {
    "TMDB_TIMEOUT_MS": "5000",
    "PUSH_TIMEOUT_MS": "8000",
    "TMDB_VOLATILE_CACHE_TTL": "10800",
    "TMDB_CACHE_TTL": "604800"
  },

  // A Worker has no long-lived process, so the setInterval that used to drive
  // release reminders on Render has nowhere to live. This trigger calls
  // scheduled() -> processDueNotifications() instead. Hourly, because a title
  // released today should not wait until tomorrow, and each pass is a KV list
  // plus one POST per due reminder.
  "triggers": {
    "crons": ["15 * * * *"]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    /*  WHY THE SSR PATHS ARE LISTED HERE
     *  not_found_handling "single-page-application" makes the asset router match
     *  EVERY path — anything that is not a file is answered with index.html — and
     *  the asset router runs before the Worker unless a path is named below. So
     *  worker.js was never invoked for /movies/prime-video, /movie/<id>-<slug> or
     *  their siblings: the SSR handlers could not run and the browser got the
     *  homepage under the right URL (and crawlers got the homepage <title> and
     *  canonical on every category and detail URL).
     *
     *  These patterns hand those paths to the Worker first. Anything it does not
     *  claim still falls through to env.ASSETS.fetch(), so the SPA keeps serving
     *  unknown slugs exactly as before.
     *
     *  "/" AND "/index.html" ARE HERE FOR A DIFFERENT REASON
     *  worker.js has a `path.endsWith('.html') || path === '/'` branch that sets
     *  `max-age=300, s-maxage=3600, stale-while-revalidate=86400` and appends
     *  `Link: <https://image.tmdb.org>; rel=preconnect` for Early Hints. Without
     *  "/" listed here the asset router answered the homepage directly and that
     *  branch never ran — so the single most-requested document on the site, the
     *  one 90% of mobile users land on, was the only one getting neither the
     *  stale-while-revalidate policy nor the 103 Early Hint. The code was written
     *  for it; only the route was missing.
     *
     *  Cost is one Worker invocation, and it is recovered immediately: the
     *  homepage now also lands in caches.default under a tracking-param-scrubbed
     *  key, so every ?utm_* / ?fbclid variant of a shared link shares one edge
     *  entry instead of missing individually.
     */
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/movies",
      "/movies/*",
      "/series",
      "/series/*",
      "/movie/*",
      "/tv/*",
      "/browse",
      "/browse/*",
      "/sitemap.xml",
      "/sitemap-*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "TMDB_CACHE",
      "id": "7afa38a8eae1409285fbbd368e6d0063"
    },
    {
      // sub:<hash>            one row per browser push subscription
      // notify:<hash>:<movie> one row per movie a subscriber asked about
      "binding": "PUSH_SUBS",
      "id": "11aac5b94b014f7bb1c04fc45a23f4a0"
    }
  ]

  // SECRETS THIS WORKER NEEDS — set with `wrangler secret put <NAME>`, never here.
  // They are not optional: without the VAPID pair /api/push/vapid-key answers 503
  // and the browser silently skips subscribing, which is the failure this
  // migration shipped with.
  //
  //   TMDB_TOKEN         v4 read access token for the /api/tmdb proxy
  //   VAPID_PUBLIC_KEY   from `npx web-push generate-vapid-keys`
  //   VAPID_PRIVATE_KEY  the matching private half — whoever holds it can push
  //                      to every subscriber
  //   VAPID_EMAIL        e.g. mailto:admin@moviezone.dev (contact for the push
  //                      services, per RFC 8292)
  //   CRON_SECRET        optional; when set, /api/notifications/process-due
  //                      requires it. The cron trigger above does not — it calls
  //                      scheduled() directly.
  //
  // Reuse the SAME VAPID pair the Render deployment used. A new pair invalidates
  // every existing subscription: those browsers keep an applicationServerKey
  // bound to the old public key and their endpoints start answering 403.
}
