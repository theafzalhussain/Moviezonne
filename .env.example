# Copy this file to .env and fill in real values. .env is gitignored; this file
# is NOT — it is committed to a public repository, so it must never contain a
# real credential. Placeholders only.

# TMDB API access — https://www.themoviedb.org/settings/api
TMDB_TOKEN=REPLACE_WITH_TMDB_READ_ACCESS_TOKEN
TMDB_API_KEY=REPLACE_WITH_TMDB_API_KEY

# Persistent push subscriptions and movie notification selections
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/moviezone?retryWrites=true&w=majority

# Generate this matching pair with: npx web-push generate-vapid-keys
# The public key ships to browsers by design. The private key must stay secret —
# whoever holds it can send push notifications to every subscriber.
VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
VAPID_EMAIL=mailto:admin@example.com


# Protects /api/notifications/process-due in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Error monitoring — Settings → Client Keys (DSN) in the Sentry project
SENTRY_DSN=https://PUBLIC_KEY@oORG_ID.ingest.us.sentry.io/PROJECT_ID

# Used only by a long-running local/Node deployment
PORT=3001
